{
  "manifest_version": 3,
  "name": "Netuno SEI Integrator",
  "version": "2.3",
  "description": "Automatiza a autuação de processos, anexo do relatório CAESB, geração do memorando e tramitação no SEI DF.",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "*://sei.df.gov.br/*",
    "https://sei.df.gov.br/*",
    "*://sip.df.gov.br/*",
    "https://sip.df.gov.br/*",
    "https://netuno-eight.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://netuno-eight.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "netuno-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://sei.df.gov.br/*",
        "https://sei.df.gov.br/*",
        "*://sip.df.gov.br/*",
        "https://sip.df.gov.br/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Netuno SEI - Clique para abrir ou dar Play",
    "default_popup": "popup.html"
  }
}
